# ==========================================
# Stack Implementation
# ==========================================

print("=== Stack Operations ===")

stack = []

# Push
stack.append(10)
stack.append(20)
stack.append(30)

print("Stack:", stack)

# Pop
stack.pop()

print("After pop:", stack)

# Peek
print("Top element:", stack[-1])


# ==========================================
# Infix to Postfix
# ==========================================

print("\n=== Infix to Postfix ===")


def precedence(op):
    if op == "+" or op == "-":
        return 1

    if op == "*" or op == "/" or op == "%":
        return 2

    if op == "^":
        return 3

    return 0


def infix_to_postfix(expression):
    stack = []
    result = ""

    for char in expression:

        if char.isalnum():
            result += char

        elif char == "(":
            stack.append(char)

        elif char == ")":

            while stack and stack[-1] != "(":
                result += stack.pop()

            if stack:
                stack.pop()

        else:

            while (
                stack
                and stack[-1] != "("
                and precedence(stack[-1]) >= precedence(char)
            ):
                result += stack.pop()

            stack.append(char)

    while stack:
        result += stack.pop()

    return result


expression = "A+B*C"

print("Infix expression:", expression)
print("Postfix expression:", infix_to_postfix(expression))

print("\nProgram executed successfully.")
