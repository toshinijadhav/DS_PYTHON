# Practical 4
# Tuple, Set and Dictionary Operations

# =========================
# Tuple Operations
# =========================

print("=== Tuple Operations ===")

t = (10, 20, 30, 40)

print("Tuple:", t)
print("First element:", t[0])
print("Second element:", t[1])
print("Slicing:", t[1:3])

t2 = (50, 60)

print("Concatenation:", t + t2)
print("Repetition:", t * 2)

# =========================
# Set Operations
# =========================

print("\n=== Set Operations ===")

s = {1, 2, 3, 4}

print("Original set:", s)

s.add(5)
print("After adding 5:", s)

s.remove(2)
print("After removing 2:", s)

s1 = {1, 2, 3, 4}
s2 = {3, 4, 5, 6}

print("Union:", s1 | s2)
print("Intersection:", s1 & s2)
print("Difference:", s1 - s2)

# =========================
# Dictionary Operations
# =========================

print("\n=== Dictionary Operations ===")

student = {
    "name": "Amit",
    "age": 20,
    "marks": 85
}

print("Original Dictionary:", student)

print("Name:", student["name"])

student["marks"] = 90
student["city"] = "Nagpur"

del student["age"]

print("Updated Dictionary:", student)

print("Dictionary keys:", student.keys())
print("Dictionary values:", student.values())
print("Dictionary items:", student.items())

print("\nProgram executed successfully.")
