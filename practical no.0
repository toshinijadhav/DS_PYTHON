
if x > y:
    print("x is greater than y")
else:
    print("y is greater than x")

print("\n=== For Loop ===")

for i in range(5):
    print(i)

print("\n=== While Loop ===")

i = 0
while i < 5:
    print(i)
    i += 1

print("\n=== Break Example ===")

for i in range(5):
    if i == 3:
        break
    print(i)

print("\nProgram executed successfully.")

